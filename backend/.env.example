# ============================================================================
# IshConnect LMS — Backend environment
# Copy to backend/.env and fill in real values. Never commit real secrets.
# ============================================================================

NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
CLIENT_ORIGIN=http://localhost:5173

# ---------------------------------------------------------------------------
# Database (MongoDB Atlas or local mongod)
# ---------------------------------------------------------------------------
MONGODB_URI=mongodb://127.0.0.1:27017/ishconnect_lms
# For Atlas use e.g.
# MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>/ishconnect_lms?retryWrites=true&w=majority

# ---------------------------------------------------------------------------
# Auth / sessions
# ---------------------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d
COOKIE_NAME=ish_session
COOKIE_DOMAIN=
# Set COOKIE_SECURE=true in production (requires HTTPS)
COOKIE_SECURE=false
CSRF_ENABLED=true

# ---------------------------------------------------------------------------
# First administrator bootstrap (used only by `npm run create-admin`)
# ---------------------------------------------------------------------------
ADMIN_EMAIL=admin@ishconnect.local
ADMIN_PASSWORD=
ADMIN_NAME=Platform Administrator

# ---------------------------------------------------------------------------
# Storage (uploaded books, logos, certificates, signatures)
# driver: local | s3
# ---------------------------------------------------------------------------
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./storage
# Public base URL used to build file links when using local storage
PUBLIC_API_URL=http://localhost:4000

# S3 / S3-compatible (Cloudflare R2, AWS S3, MinIO, Backblaze B2)
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_BASE_URL=

# ---------------------------------------------------------------------------
# Book processing
# ---------------------------------------------------------------------------
# Max upload size in megabytes
UPLOAD_MAX_MB=200
# Enable OCR fallback for scanned PDFs (requires tesseract.js + language data)
OCR_ENABLED=true
OCR_LANGUAGES=eng
# Where extracted book text/metadata JSON is cached
BOOK_CACHE_DIR=./storage/book-cache

# ---------------------------------------------------------------------------
# Certificates
# ---------------------------------------------------------------------------
CERTIFICATE_VERIFY_BASE_URL=http://localhost:5173/verify
# Directory for generated certificate PDFs (local storage driver)
CERTIFICATE_DIR=./storage/certificates

# ---------------------------------------------------------------------------
# Seed source content (the book library at the repo root)
# ---------------------------------------------------------------------------
CONTENT_ROOT=..
SEED_ADMIN_EMAIL=admin@ishconnect.local
SEED_ADMIN_PASSWORD=ChangeMe123!
